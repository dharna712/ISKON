      {"sa": "pūrṇam", "en": "complete, perfect", "hi": "पूर्ण"},
      {"sa": "adaḥ", "en": "that (the transcendent source)", "hi": "वह (परम स्रोत)"},
      {"sa": "idam", "en": "this (the manifest world)", "hi": "यह (प्रकट जगत)"},
      {"sa": "pūrṇāt", "en": "from the complete", "hi": "पूर्ण से"},
